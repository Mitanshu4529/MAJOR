# Copy this file to .env and fill in your own values.
# Never commit .env (it is already in .gitignore).

# LLM for every agent - https://console.groq.com/keys
GROQ_API_KEY=

# LLM fallback chain (optional - these are the defaults). Models are tried in
# order; if one fails or is rate-limited, the next one answers.
# GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b
# Local models via Ollama (https://ollama.com), used when all Groq models fail.
# Leave empty (OLLAMA_MODELS=) to turn local models off.
# OLLAMA_MODELS=qwen3:8b,llama3.2:3b
# OLLAMA_BASE_URL=http://localhost:11434

# PostgreSQL - stores each plan's progress so it can pause for approval.
# Local Docker Postgres (see README):
DATABASE_URL=postgresql://tripmate:tripmate@localhost:5432/tripmate
# Or a hosted database (Neon / Supabase / Render) - paste its connection string:
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Hotel agent (web search) - https://app.tavily.com
TAVILY_API_KEY=

# Flight agent (airports/airlines) - https://aviationstack.com/signup/free
AVIATION_STACK_API_KEY=

# Weather agent - https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=
